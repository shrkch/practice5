digraph C {
graph [rankdir=TB, bgcolor="white", pad=0.2, nodesep=0.35, ranksep=0.4];
node [shape=record, style="filled", fontname="Times New Roman", fontsize=10, color="#2F5597", fillcolor="#F7FBFF"];
edge [fontname="Times New Roman", fontsize=9, color="#555555"];
a [label="{TimesheetAnalyzer|- DAYS: int = 5\l- FIELDS: int = 6\l- MAX_HOURS: int = 16\l- DAILY_NORMAL_HOURS: int = 8\l- WEEKLY_NORMAL_HOURS: int = 40\l- OVERTIME_RATE: double = 1.5\l|+ parseHours(String) int[]\l+ parseRate(String) double\l+ total(int[]) int\l+ average(int[]) double\l+ overtimeDays(int[]) int\l+ weeklyOvertime(int[]) int\l+ addPayForWeek(int[], double) double\l- splitLine(String) String[]\l- parseHourValue(String, int) int\l- parseRateValue(String) double\l- checkHours(int[]) void\l}", fillcolor="#FDE9E7", color="#C00000"];
s [label="{SelfCheck||+ main(String[]) void\l}"];
s -> a [label="использует", style=dashed, arrowhead=vee];
}

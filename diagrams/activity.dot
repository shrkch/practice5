digraph G {
graph [rankdir=TB, bgcolor="white", pad=0.2, nodesep=0.25, ranksep=0.35];
node [shape=box, style="rounded,filled", fontname="Times New Roman", fontsize=11, color="#2F5597", fillcolor="#EAF2F8", margin="0.12,0.08"];
edge [fontname="Times New Roman", fontsize=9, color="#555555"];
start [label="Начало", shape=oval, fillcolor="#E2F0D9", color="#548235"];
end [label="Завершение", shape=oval, fillcolor="#FCE4D6", color="#C65911"];
n1 [label="Получить строку часов и ставку", shape=parallelogram, fillcolor="#E4DFEC", color="#7030A0"];
n2 [label="Разделить строку:\nsplit(\";\", -1)"];
n3 [label="Ровно шесть значений\n(5 значений часов + ставка)", shape=diamond, fillcolor="#FFF2CC", color="#BF9000"];
n4 [label="A1 Для каждого из 5 элементов:\nпроверить regex и диапазон [0, 16],\nпреобразовать в int;\nставку (позиция 6) проверить: число > 0", fillcolor="#F4CCCC", color="#C00000", style="rounded,filled"];
n5 [label="Все элементы корректны", shape=diamond, fillcolor="#FFF2CC", color="#BF9000"];
n6 [label="Вычислить total, average (2 знака),\novertimeDays и weeklyOvertime"];
n6b [label="Вычислить оплату за неделю:\ntotal × ставка + weeklyOvertime × ставка × 1.5"];
n7 [label="A2 Сформировать итоговый отчёт:\nсумма, среднее, дни с переработкой,\nнедельная переработка, оплата за неделю", fillcolor="#F4CCCC", color="#C00000", style="rounded,filled"];
n8 [label="Сформировать сообщение об ошибке"];
start -> n1;
n1 -> n2;
n2 -> n3;
n3 -> n4 [label="да"];
n3 -> n8 [label="нет"];
n4 -> n5;
n5 -> n6 [label="да"];
n5 -> n8 [label="нет"];
n6 -> n6b;
n6b -> n7;
n7 -> end;
n8 -> end;
}
